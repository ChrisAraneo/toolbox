{
  "name": "@chris.araneo/ng-perfectionism",
  "targets": {
    "build": {},
    "chores": {},
    "format": {
      "options": {
        "commands": [
          "npx sort-package-json package.json",
          "npx prettier --write tsconfig.lib.json tsconfig.json package.json project.json \"*.{ts,js,mjs,cjs}\" \"src/**/*.ts\""
        ],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "lint": {},
    "start": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/index.js",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-vm-modules node_modules/jest/bin/jest.js ./packages/ng-perfectionism --collectCoverage=false"
      }
    },
    "typecheck": {}
  }
}
