{
  "name": "@chris.araneo/ng-perfectionism",
  "targets": {
    "build": {},
    "chores": {},
    "format": {
      "options": {
        "command": "node scripts/format-package ng-perfectionism"
      }
    },
    "lint": {},
    "start": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/index.js",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-vm-modules node_modules/jest/bin/jest.js ./packages/ng-perfectionism --collectCoverage=false"
      }
    },
    "typecheck": {}
  }
}
